# Згенеровані й сторонні FIT-файли не комітимо; публічні фікстури — виняток.
*.fit
!tests/fixtures/public/**/*.fit

# Приватні GPS-дані. Це правило має стояти ПІСЛЯ винятків вище, бо в .gitignore
# перемагає останнє правило, що підійшло.
tests/fixtures/private/*
!tests/fixtures/private/.gitkeep

