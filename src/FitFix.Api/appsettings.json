{
  // The framework logs several lines per request at information level, each carrying the full
  // request URL — which from Story 2.2 on carries query strings. AD-9 allows duration, sizes
  // and codes, so the service's own line is the record of a request, and the framework speaks
  // only when something is wrong.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
