<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test host runs the API's own pipeline on Kestrel, so it needs the same framework
         the API does. No test-host package: nothing here stands in for the real server. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API's own log levels, so the AD-9 assertions see the channels production sees:
         the framework's request lines carry a decoded path, and this file is what quiets them. -->
    <Content Include="..\..\src\FitFix.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core suite's synthetic fixtures, linked rather than copied: an HTTP test has to send
         the very same bytes the core tests read, and a second generator of a FIT activity would
         drift from this one. Only the fixtures are shared — no test of the core suite runs here. -->
    <Compile Include="..\FitFix.Core.Tests\Fixtures\SyntheticRun.cs" Link="Fixtures\SyntheticRun.cs" />
    <Compile Include="..\FitFix.Core.Tests\Fixtures\SyntheticFitBuilder.cs" Link="Fixtures\SyntheticFitBuilder.cs" />
    <!-- Reads the summary messages back out of a written FIT, which is how an HTTP test checks
         that the base64 in the answer really is the file the report describes. -->
    <Compile Include="..\FitFix.Core.Tests\Fixtures\FitMessageInspector.cs" Link="Fixtures\FitMessageInspector.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FitFix.Api\FitFix.Api.csproj" />
  </ItemGroup>

</Project>
